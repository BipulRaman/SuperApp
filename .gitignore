# Patterns are anchored from this file's location (repo root) and apply recursively,
# so they cover the Expo project under app/ as well.
node_modules/
.expo/
dist/
web-build/
npm-debug.*
*.log
.DS_Store
.env*
# Native folders generated by `expo prebuild`
app/android/
app/ios/
# Local-only signing material (never commit; the CI build uses the
# DEBUG_KEYSTORE_BASE64 repository secret instead)
app/android-keystore/
*.keystore
*.jks
