<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Only needed to save downloads into the public Downloads folder on Android 9 and older. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Backups are off so login cookies never leave the device (allowBackup="false" covers
         Android 11 and older, the extraction rules cover device transfers on 12+). -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SuperApp"
        tools:ignore="DataExtractionRules"
        tools:targetApi="33">

        <!-- configChanges: the activity owns the live WebViews, so it must never be recreated
             (rotation, dark mode, font size, keyboard...) or every open site would reload.
             Portrait on phones like the original app; fullscreen video unlocks rotation. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="colorMode|density|fontScale|fontWeightAdjustment|keyboard|keyboardHidden|layoutDirection|locale|mcc|mnc|navigation|orientation|screenLayout|screenSize|smallestScreenSize|touchscreen|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            tools:ignore="DiscouragedApi,LockedOrientationActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Lets camera apps write a photo/video for uploads; only reachable via one-off URI grants. -->
        <provider
            android:name=".browser.CaptureProvider"
            android:authorities="${applicationId}.captures"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
