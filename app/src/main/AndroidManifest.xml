<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The only permission, needed to load the sites. Android grants it at install and never
         asks; SuperApp requests no runtime permissions (camera, microphone, location, storage,
         contacts...), and sites' requests for them are always refused. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Backups are off so login cookies never leave the device (allowBackup="false" covers
         Android 11 and older, the extraction rules cover device transfers on 12+). -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SuperApp"
        tools:ignore="DataExtractionRules"
        tools:targetApi="33">

        <!-- configChanges: the activity owns the live WebViews, so it must never be recreated
             (rotation, dark mode, font size, keyboard...) or every open site would reload.
             Portrait on phones like the original app; fullscreen video unlocks rotation. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="colorMode|density|fontScale|fontWeightAdjustment|keyboard|keyboardHidden|layoutDirection|locale|mcc|mnc|navigation|orientation|screenLayout|screenSize|smallestScreenSize|touchscreen|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            tools:ignore="DiscouragedApi,LockedOrientationActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Links to the sites tapped in other apps (WhatsApp, Gmail...) open here. Android 12+
                 only sends them once the user approves them on SuperApp's "Open by default"
                 settings page (the drawer leads there). Only a domain's owner can verify App Links,
                 so there's no autoVerify (AppLinkWarning). Hosts must match Site.linkHosts in
                 data/Sites.kt (tested). -->
            <intent-filter tools:ignore="AppLinkWarning">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:scheme="http" />
                <data android:host="facebook.com" />
                <data android:host="*.facebook.com" />
                <data android:host="fb.watch" />
                <data android:host="fb.me" />
            </intent-filter>
            <intent-filter tools:ignore="AppLinkWarning">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:scheme="http" />
                <data android:host="instagram.com" />
                <data android:host="*.instagram.com" />
            </intent-filter>
            <intent-filter tools:ignore="AppLinkWarning">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:scheme="http" />
                <data android:host="x.com" />
                <data android:host="*.x.com" />
                <data android:host="twitter.com" />
                <data android:host="*.twitter.com" />
            </intent-filter>
            <intent-filter tools:ignore="AppLinkWarning">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:scheme="http" />
                <data android:host="linkedin.com" />
                <data android:host="*.linkedin.com" />
            </intent-filter>
        </activity>

        <!-- Lets camera apps write a photo/video for uploads; only reachable via one-off URI grants. -->
        <provider
            android:name=".browser.CaptureProvider"
            android:authorities="${applicationId}.captures"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
