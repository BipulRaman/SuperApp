<?xml version="1.0" encoding="utf-8"?>
<com.example.superapp.ui.SquareFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:foreground="@drawable/tile_ripple"
    android:padding="18dp">

    <ImageView
        android:id="@+id/glyph"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/initial"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no"
        android:includeFontPadding="false"
        android:textColor="@color/text_primary"
        android:textSize="36sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Shown while the site is loaded in the background (reopening it is instant). -->
    <View
        android:id="@+id/live"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:layout_gravity="top|end"
        android:layout_margin="4dp"
        android:background="@drawable/live_dot"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <TextView
        android:id="@+id/name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:importantForAccessibility="no"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:textStyle="bold" />
</com.example.superapp.ui.SquareFrameLayout>
